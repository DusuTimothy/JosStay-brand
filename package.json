{
  "name": "josstay",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @josstay/client",
    "dev:server": "npm run dev -w @josstay/server",
    "build": "npm run build -w @josstay/shared && npm run build -w @josstay/client && npm run build -w @josstay/server",
    "build:shared": "npm run build -w @josstay/shared",
    "start": "npm run start -w @josstay/client",
    "start:server": "npm run start -w @josstay/server",
    "typecheck": "npm run typecheck -w @josstay/shared && npm run typecheck -w @josstay/client && npm run typecheck -w @josstay/server",
    "migrate": "npm run migrate -w @josstay/server",
    "migrate:undo": "npm run migrate:undo -w @josstay/server",
    "migrate:status": "npm run migrate:status -w @josstay/server",
    "verify:db": "npm run verify:db -w @josstay/server",
    "verify:models": "npm run verify:models -w @josstay/server",
    "verify:cache": "npm run verify:cache -w @josstay/server",
    "verify:api": "npm run verify:api -w @josstay/server",
    "verify:booking": "npm run verify:booking -w @josstay/server",
    "verify:payments": "npm run verify:payments -w @josstay/server",
    "verify:guest": "npm run verify:guest -w @josstay/server",
    "verify:refund": "npm run verify:refund -w @josstay/server",
    "verify:partner": "npm run verify:partner -w @josstay/client"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}

{
  "name": "@josstay/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/db/migrate.ts",
    "verify:db": "tsx src/db/verify-schema.ts",
    "verify:cache": "tsx src/cache/verify.ts"
  },
  "dependencies": {
    "@josstay/shared": "file:../packages/shared",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "22.18.12",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
